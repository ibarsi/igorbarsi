---
import Navigation from '../Navigation/index.astro';
import styles from './header.module.css';

interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props;
---

<header class={styles.shell}>
  <div class={styles.container}>
    <a href="/" class={styles.brand}>
      <span class={styles.brandMark}>IB</span>
      <span class={styles.brandName}>Igor Barsi</span>
    </a>

    <nav class={styles.navigation} aria-label="Primary">
      <Navigation pathname={pathname} />
    </nav>
  </div>
</header>
