---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import styles from '../../templates/blog-post.module.css';
import { buildPageTitle, formatPostDateWithYear } from '../../utils.js';
import { DEFAULT_SOCIAL_IMAGE, SITE_TITLE, SITE_URL } from '../../site-config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = buildPageTitle(entry.data.title);
const description =
  entry.data.description ??
  (entry.body ?? '')
    .replace(/[`*_>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 220);
const [month, day, year] = entry.data.date.split('-');
const publishedDate = `${year}-${month}-${day}`;
const canonical = new URL(`/blog/${entry.data.slug}/`, SITE_URL).toString();
const image = new URL(DEFAULT_SOCIAL_IMAGE, SITE_URL).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description,
  datePublished: publishedDate,
  image: [image],
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  author: {
    '@type': 'Person',
    name: SITE_TITLE,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: SITE_TITLE,
    url: SITE_URL,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  pathname={`/blog/${entry.data.slug}/`}
  publishedDate={publishedDate}
  structuredData={structuredData}
  type="article"
>
  <article class={`${styles.shell} animate-in`}>
    <header class={styles.header}>
      <a href="/blog/" class={styles.backLink}>&larr; Back to archive</a>
      <h1 class={styles.headerHeadline}>{entry.data.title}</h1>
      <span class={styles.headerByline}>
        Igor Barsi <span class="separator"></span>
        {formatPostDateWithYear(entry.data.date)}
      </span>
    </header>

    <div class={`${styles.markdown} ${styles.content}`}>
      <Content />
    </div>

    <footer class={styles.footer}>
      <a href="/blog/" class={styles.backLink}>&larr; Back to archive</a>
    </footer>
  </article>
</BaseLayout>
