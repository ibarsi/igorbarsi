---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import styles from '../../templates/blog-post.module.css';
import { buildPageTitle, formatPostDateWithYear } from '../../utils.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = buildPageTitle(entry.data.title);
const description =
  entry.data.description ??
  (entry.body ?? '')
    .replace(/[`*_>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 220);
---

<BaseLayout
  title={title}
  description={description}
  pathname={`/blog/${entry.data.slug}/`}
  type="article"
>
  <article class={`${styles.shell} animate-in`}>
    <header class={styles.header}>
      <a href="/blog/" class={styles.backLink}>&larr; Back to archive</a>
      <h1 class={styles.headerHeadline}>{entry.data.title}</h1>
      <span class={styles.headerByline}>
        Igor Barsi <span class="separator"></span>
        {formatPostDateWithYear(entry.data.date)}
      </span>
    </header>

    <div class={`${styles.markdown} ${styles.content}`}>
      <Content />
    </div>

    <footer class={styles.footer}>
      <a href="/blog/" class={styles.backLink}>&larr; Back to archive</a>
    </footer>
  </article>
</BaseLayout>
