---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not Found - 404"
  description="Page not found. Return to www.igorbarsi.com."
  robots="noindex, nofollow"
>
  <div class="animate-in" style="padding-top: 4rem; max-width: 32rem;">
    <p
      style="margin: 0 0 1.5rem; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);"
    >
      404
    </p>
    <h1 class="title" style="margin-bottom: 1.5rem;">Page not found</h1>
    <p class="paragraph paragraph--intro">
      The page you were looking for doesn&apos;t exist.
    </p>
    <a
      href="/"
      style="font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase;"
    >
      &larr; Go home
    </a>
  </div>
</BaseLayout>
