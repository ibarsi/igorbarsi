---
import { getCollection } from 'astro:content';

import heroTerminal from '../assets/hero-terminal.png';
import RecentBlogPosts from '../components/RecentBlogPosts/index.astro';
import { getSelectedRepositories } from '../data/github';
import BaseLayout from '../layouts/BaseLayout.astro';
import styles from './index.module.css';
import { buildPageTitle } from '../utils.js';

const title = buildPageTitle();
const description =
  'Igor Barsi is a software developer and writer focused on effective engineering and leadership. You can find links to his writing and work here at igorbarsi.com.';

const posts = await getCollection('blog');
posts.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const repositories = getSelectedRepositories();
---

<BaseLayout title={title} description={description}>
  <div class={styles.page}>
    <section class={`${styles.hero} ${styles.shell}`}>
      <div class={styles.heroCopy}>
        <p class={styles.kicker}>Igor Barsi · software engineer</p>
        <h1 class={styles.headline}>
          Better systems, <span class={styles.headlineHighlight}
            >more human</span
          > engineering.
        </h1>
        <p class={styles.summary}>
          I write for engineers who care about how software gets made: the
          craft, communication, habits, and choices behind durable work.
        </p>
        <div class={styles.heroActions}>
          <a href="#writing" class={styles.primaryAction}>Start reading</a>
          <a
            href="https://www.linkedin.com/in/ibarsi/"
            class={styles.secondaryAction}>Find me on LinkedIn</a
          >
        </div>
      </div>
      <figure class={styles.signalField}>
        <img
          src={heroTerminal.src}
          alt="An ivory desktop computer with a terminal screen and keyboard"
          class={styles.terminalRender}
        />
      </figure>
    </section>

    <section id="writing" class={styles.writingBand}>
      <div class={`${styles.shell} ${styles.writingInner}`}>
        <div class={styles.writingIntro}>
          <p class={styles.railLabel}>Writing desk</p>
          <h2 class={styles.writingTitle}>
            Notes for engineers who care about the work.
          </h2>
          <p class={styles.writingCopy}>
            Field notes on delivery, technical practice, and the human systems
            that make software durable.
          </p>
          <a href="/blog/" class={styles.allPosts}>Browse all writing</a>
        </div>
        <div class={styles.postFrame}>
          <RecentBlogPosts entries={posts} limit={3} />
        </div>
      </div>
    </section>

    <section class={styles.contributionsBand}>
      <div class={`${styles.shell} ${styles.contributionsInner}`}>
        <div class={styles.contributionsIntro}>
          <p class={styles.railLabel}>Open-source contributions</p>
          <h2 class={styles.contributionsTitle}>
            Tools I’ve helped move forward.
          </h2>
          <p class={styles.contributionsCopy}>
            Recent work in the open, on projects I use and care about.
          </p>
        </div>
        <ol class={styles.contributionList}>
          {
            repositories.map((repository, index) => (
              <li class={styles.contributionRow}>
                <p class={styles.contributionIndex}>
                  {String(index + 1).padStart(2, '0')}
                </p>
                <div class={styles.contributionMain}>
                  <p class={styles.contributionLabel}>Contributed to</p>
                  <h3 class={styles.contributionTitle}>{repository.name}</h3>
                  <p class={styles.contributionCopy}>
                    {repository.description}
                  </p>
                </div>
                <div class={styles.contributionMeta}>
                  <p>{repository.category}</p>
                  <p>
                    {repository.language ?? 'Open source'} · Updated{' '}
                    {repository.updatedLabel}
                  </p>
                  <a
                    class={styles.contributionLink}
                    href={repository.url}
                    rel="noreferrer"
                    target="_blank"
                  >
                    View on GitHub <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
