---
import { getCollection } from 'astro:content';

import RecentBlogPosts from '../components/RecentBlogPosts/index.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import styles from './index.module.css';
import { buildPageTitle } from '../utils.js';

const title = buildPageTitle();
const description =
  'Igor Barsi is a software developer and writer focused on effective engineering and leadership. You can find links to his writing and work here at igorbarsi.com.';

const posts = await getCollection('blog');
posts.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---

<BaseLayout title={title} description={description}>
  <div class={styles.page}>
    <section class={`${styles.hero} animate-in`}>
      <div class={styles.hyperframe} aria-hidden="true">
        <span class={styles.frameLine}></span>
        <span class={styles.frameLine}></span>
        <span class={styles.frameLine}></span>
      </div>
      <p class={styles.label}>Software Engineer &amp; Writer</p>
      <h1 class={styles.headline}>
        <span>Building better teams,</span>
        <span>habits, and software.</span>
      </h1>
      <p class={`paragraph paragraph--intro ${styles.summary}`}>
        I write about the human side of engineering — delivery, leadership,
        communication, and the routines that shape durable technical work.
      </p>

      <div class={styles.heroActions}>
        <a href="/blog/" class={styles.primaryAction}>Read the blog</a>
        <a
          href="https://www.linkedin.com/in/ibarsi/"
          class={styles.secondaryAction}
        >
          LinkedIn &rarr;
        </a>
      </div>
    </section>

    <div class={`${styles.pillars} animate-in delay-1`}>
      <article class={styles.pillar} style="--index: 0">
        <span class={styles.pillarNumber}>01</span>
        <h2 class={styles.pillarTitle}>
          Effective engineering over empty motion
        </h2>
        <p class="paragraph">
          Much of my writing is aimed at engineers, but the themes travel well:
          clear communication, disciplined habits, and systems that help people
          do meaningful work together.
        </p>
      </article>

      <article class={styles.pillar} style="--index: 1">
        <span class={styles.pillarNumber}>02</span>
        <h2 class={styles.pillarTitle}>Opinionated, practical, and grounded</h2>
        <p class="paragraph">
          I share what has proven useful, where teams tend to struggle, and the
          patterns that seem to compound over time.
        </p>
      </article>
    </div>

    <section class={`${styles.postsSection} animate-in delay-2`}>
      <div class={styles.sectionHeader}>
        <div>
          <p class={styles.label}>Latest</p>
          <h2 class={styles.sectionTitle}>Recent writing</h2>
        </div>
        <a href="/blog/" class={styles.sectionLink}>All posts &rarr;</a>
      </div>

      <RecentBlogPosts entries={posts} limit={3} />
    </section>
  </div>
</BaseLayout>
