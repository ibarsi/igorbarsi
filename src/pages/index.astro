---
import { getCollection } from 'astro:content';

import RecentBlogPosts from '../components/RecentBlogPosts/index.astro';
import SocialLinks from '../components/SocialLinks/index.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import styles from './index.module.css';
import { buildPageTitle } from '../utils.js';

const title = buildPageTitle();
const description =
  'Igor Barsi is a software developer and writer focused on effective engineering and leadership. You can find links to his writing and work here at igorbarsi.com.';

const posts = await getCollection('blog');
posts.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---

<BaseLayout title={title} description={description}>
  <div class={styles.page}>
    <section class={styles.hero}>
      <div class={styles.heroIntro}>
        <p class={styles.eyebrow}>
          Software developer, writer, and engineering lead
        </p>
        <h1 class="title">
          Ideas for building better teams, habits, and software.
        </h1>
        <p class={`paragraph paragraph--intro ${styles.summary}`}>
          I write about the human side of engineering: delivery, leadership,
          communication, and the routines that shape durable technical work.
        </p>

        <div class={styles.heroActions}>
          <a href="/blog/" class={styles.primaryAction}> Read the blog </a>
          <a
            href="https://www.linkedin.com/in/ibarsi/"
            class={styles.secondaryAction}
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <aside class={styles.heroPanel}>
        <p class={styles.panelLabel}>What you will find here</p>
        <ul class={styles.panelList}>
          <li>Practical writing for engineers and leaders</li>
          <li>Lessons on process, clarity, and collaboration</li>
          <li>Thoughtful opinions shaped by real delivery work</li>
        </ul>
      </aside>
    </section>

    <section class={styles.storyGrid}>
      <article class={styles.storyCard}>
        <p class={styles.cardEyebrow}>Focus</p>
        <h2 class={styles.cardTitle}>
          Effective engineering over empty motion.
        </h2>
        <p class="paragraph">
          Much of my writing is aimed at engineers, but the themes travel well:
          clear communication, disciplined habits, and systems that help people
          do meaningful work together.
        </p>
      </article>

      <article class={styles.storyCard}>
        <p class={styles.cardEyebrow}>Approach</p>
        <h2 class={styles.cardTitle}>Opinionated, practical, and grounded.</h2>
        <p class="paragraph">
          I do not claim to have all the answers. I share what has proven
          useful, where teams tend to struggle, and the patterns that seem to
          compound over time.
        </p>
      </article>
    </section>

    <section class={styles.postsSection}>
      <div class={styles.sectionHeading}>
        <div>
          <p class={styles.eyebrow}>Latest writing</p>
          <h2 class={styles.sectionTitle}>Recent blog posts</h2>
        </div>
        <a href="/blog/" class={styles.sectionLink}> View all posts </a>
      </div>

      <RecentBlogPosts entries={posts} limit={3} />
    </section>

    <section class={styles.contactSection}>
      <div class={styles.contactCopy}>
        <p class={styles.eyebrow}>Elsewhere</p>
        <h2 class={styles.sectionTitle}>Follow the work outside the blog.</h2>
        <p class="paragraph">
          The site should feel more alive than it used to, but the core goal
          stays the same: publish useful ideas and make them easy to find.
        </p>
      </div>

      <div class={styles.socialWrap}>
        <SocialLinks />
      </div>
    </section>
  </div>
</BaseLayout>
